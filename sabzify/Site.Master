<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="sabzify.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        /* Search error floats under the box so the header height never changes. */
        .header-search .search-error {
            position: absolute;
            top: calc(100% + 6px);
            left: 12px;
            z-index: 20;
            padding: 4px 10px;
            border-radius: 6px;
            background: #fff;
            box-shadow: 0 4px 14px rgba(26, 43, 32, .12);
            font-size: 12px;
            line-height: 1.3;
            color: #C0392B;
            white-space: nowrap;
        }
    </style>

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header class="site-header">
            <div class="shell header-inner">

                <a class="site-brand" runat="server" href="~/">
                    <span class="site-brand-name">Sabzify</span>
                </a>

                <%-- DefaultButton makes Enter click the hidden btnSearch, which validates
                     only the "Search" group, so other pages' buttons are unaffected. --%>
                <asp:Panel ID="pnlSearch" runat="server" CssClass="header-search" DefaultButton="btnSearch">
                    <svg class="header-search-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" />
                    </svg>
                    <asp:TextBox ID="txtSearch" runat="server" CssClass="header-search-input" placeholder="Search vegetables..." aria-label="Search vegetables" />
                    <asp:RegularExpressionValidator ID="revSearch" runat="server"
                        ControlToValidate="txtSearch"
                        ValidationExpression="^[A-Za-z ]{2,40}$"
                        ErrorMessage="Enter at least 2 letters"
                        ValidationGroup="Search"
                        Display="Dynamic"
                        CssClass="search-error"
                        SetFocusOnError="true" />
                    <asp:Button ID="btnSearch" runat="server" ValidationGroup="Search" Text="Search" CssClass="visually-hidden" />
                </asp:Panel>

                <nav class="header-nav">
                    <a class="header-nav-link" runat="server" href="~/">Home</a>
                    <a class="header-nav-link" runat="server" href="~/Vegetables.aspx">Vegetables</a>
                    <a class="header-nav-link" runat="server" href="~/Wishlist.aspx">Wishlist</a>
                </nav>

                <div class="header-actions">
                    <a class="header-icon" href="Cart.aspx" aria-label="Cart">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM2 3h2.2l2.5 11.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 2-1.5L21 7H6.3l-.5-2.2A2 2 0 0 0 3.9 3H2z" />
                        </svg>
                        <span class="header-cart-badge">3</span>
                    </a>
                    <a class="header-icon" runat="server" href="~/Profile.aspx" aria-label="Account">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z" />
                        </svg>
                    </a>
                </div>

            </div>
        </header>

        <main class="site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="site-footer">
            <div class="shell footer-inner">
                <div class="footer-brand-block">
                    <span class="footer-brand">Sabzify</span>
                    <p class="footer-tagline">Fresh vegetables delivered straight from<br />local farms to your doorstep in Rajkot.</p>
                </div>
                <p class="footer-copy">&copy; <%: DateTime.Now.Year %> Sabzify. All rights reserved.</p>
            </div>
        </footer>
    </form>
    <script type="text/javascript">
        // Mark the nav link for the current page as active.
        (function () {
            // "/", "/home" and "/home.aspx" all mean the home page.
            function key(path) {
                var p = path.toLowerCase().replace(/\.aspx$/, '').replace(/\/+$/, '');
                p = p.substring(p.lastIndexOf('/') + 1);
                return p === '' ? 'home' : p;
            }
            var current = key(location.pathname);
            var links = document.querySelectorAll('.header-nav .header-nav-link');
            for (var i = 0; i < links.length; i++) {
                var a = links[i];
                if (key(a.pathname) === current) { a.className += ' is-active'; }
            }
        })();
    </script>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
